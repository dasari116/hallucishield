# Leave both blank to run HalluciShield fully offline with the built-in
# mock LLM + mock embedder (no external calls, deterministic demo mode).
OPENAI_API_KEY=
GENERATION_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
VERIFIER_MODEL=gpt-4o-mini

# Verification tuning (defaults are calibrated for the offline mock
# embedder; raise SUPPORTED_THRESHOLD to ~0.75 once OPENAI_API_KEY is set,
# since real embeddings are far more discriminative than the mock ones)
SUPPORTED_THRESHOLD=0.45
CONTRADICTED_MARGIN=0.12
TOP_K=4
MAX_CONCURRENT_VERIFICATIONS=6
